@page "/login"

<PageTitle>Login - Academic Scheduler</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h3 class="mb-3">Academic Scheduler</h3>

                <p class="text-muted">
                    Sign in to access the administration system.
                </p>

                <form method="post" action="/account/login">

                    <AntiforgeryToken />

                    <div class="mb-3">
                        <label class="form-label">Email</label>

                        <input type="email"
                               name="email"
                               class="form-control"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>

                        <input type="password"
                               name="password"
                               class="form-control"
                               required />
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Sign In
                    </button>

                </form>

            </div>
        </div>
    </div>
</div>