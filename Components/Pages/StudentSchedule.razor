@page "/students/{StudentId:int}"
@rendermode InteractiveServer
@using AcademicScheduler.Models
@using AcademicScheduler.Services
@inject StudentService StudentService
@inject CourseService CourseService
@inject EnrollmentService EnrollmentService
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize]

<PageTitle>Student Schedule</PageTitle>

@if (student is null && !loading)
{
    <div class="alert alert-danger">
        Student not found.
    </div>

    <a href="/students" class="btn btn-outline-secondary">
        Back to Students
    </a>
}
else if (loading)
{
    <p>Loading student schedule...</p>
}
else if (student is not null)
{
    <div class="mb-4">
        <a href="/students" class="text-decoration-none">
            ← Back to Students
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="mb-1">
                @student.FirstName @student.LastName
            </h1>

            <div class="text-muted">
                @student.Email
            </div>

            <div class="mt-2">
                @student.HouseAffiliation • Year @student.YearLevel
            </div>
        </div>

        <span class="badge text-bg-secondary fs-6">
            @TotalCreditLoad / @student.MaxCreditsAllowed credits
        </span>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">Academic Summary</h5>

            <div class="row mt-3">
                <div class="col-md-4">
                    <div class="text-muted">Current Credits</div>
                    <strong>@student.CurrentCredits</strong>
                </div>

                <div class="col-md-4">
                    <div class="text-muted">Newly Assigned</div>
                    <strong>@AssignedCredits</strong>
                </div>

                <div class="col-md-4">
                    <div class="text-muted">Remaining Capacity</div>
                    <strong>@RemainingCredits</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 card-title">Upcoming Schedule</h2>

            @if (student.Enrollments.Count == 0)
            {
                <p class="text-muted mb-0">
                    No courses have been assigned yet.
                </p>
            }
            else
            {
                <div class="table-responsive mt-3">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Course</th>
                                <th>Instructor</th>
                                <th>Credits</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var enrollment in student.Enrollments)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            @enrollment.Course.CourseNumber
                                        </strong>
                                        <div class="text-muted small">
                                            @enrollment.Course.CourseName
                                        </div>
                                    </td>

                                    <td>
                                        @enrollment.Course.Instructor
                                    </td>

                                    <td>
                                        @enrollment.Course.Credits
                                    </td>

                                    <td class="text-end">
                                        <AuthorizeView Policy="CanManageEnrollments">
                                            <Authorized>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => RemoveCourseAsync(enrollment.CourseId)">
                                                    Remove
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <h2 class="h4 mb-3">Courses for Upcoming Semester</h2>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6">
            <label class="form-label">Search Courses</label>

            <input type="text" class="form-control" placeholder="Course number or name..." @bind="searchTerm"
                   @bind:event="oninput" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">Department</label>

            <select class="form-select" @bind="selectedDepartment">

                <option value="">All departments</option>

                @foreach (var department in Departments)
                {
                    <option value="@department">
                        @department
                    </option>
                }
            </select>
        </div>
    </div>

    <div class="btn-group mb-3" role="group" aria-label="Course eligibility filter">

        <button class="@GetEligibilityButtonClass("all")" @onclick='() => eligibilityFilter = "all"'>
            All
        </button>

        <button class="@GetEligibilityButtonClass("eligible")" @onclick='() => eligibilityFilter = "eligible"'>
            Eligible
        </button>

        <button class="@GetEligibilityButtonClass("ineligible")" @onclick='() => eligibilityFilter = "ineligible"'>
            Ineligible
        </button>

        @{
            var filteredCourses = FilteredCourses.ToList();
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted">
                Showing @filteredCourses.Count of @courses.Count courses
            </span>

            @if (HasActiveCourseFilters)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearCourseFilters">
                    Clear Filters
                </button>
            }
        </div>

    </div>

    @if (filteredCourses.Count == 0)
    {
        <div class="alert alert-info">
            No courses match the selected filters.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (Course course in FilteredCourses)
            {
                var eligibility = EnrollmentService
                    .CheckEligibility(student, course);

                <div class="col-12 col-lg-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="mb-1">@course.CourseNumber</h5>
                                    <div class="text-muted">
                                        @course.CourseName
                                    </div>
                                </div>

                                <span class="badge text-bg-primary">
                                    @course.Credits credits
                                </span>
                            </div>

                            <div class="mt-3">
                                <div class="mb-1">
                                    <strong>Credits:</strong>
                                    @course.Credits
                                </div>

                                <div class="mb-1">
                                    <strong>Instructor:</strong>
                                    @course.Instructor
                                </div>

                                <div>
                                    <strong>Prerequisite:</strong>

                                    @if (string.IsNullOrWhiteSpace(
                                        course.PrerequisiteCourseNumber))
                                    {
                                        <span class="text-success">None</span>
                                    }
                                    else
                                    {
                                        <span>@course.PrerequisiteCourseNumber</span>
                                    }
                                </div>
                            </div>

                            <div class="mt-3">
                                @if (eligibility.IsEligible)
                                {
                                    <div class="text-success mb-1">
                                        ✓ Eligible
                                    </div>

                                    <div class="small text-muted mb-2">
                                        @TotalCreditLoad → @(TotalCreditLoad + course.Credits)
                                        credits after assignment
                                    </div>

                                    <AuthorizeView Policy="CanManageEnrollments">
                                        <Authorized>
                                            <button class="btn btn-primary" @onclick="() => AssignCourseAsync(course.Id)">
                                                Assign Course
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                }
                                else
                                {
                                    <div class="text-danger">
                                        ✕ @eligibility.Reason
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter]
    public int StudentId { get; set; }

    private Student? student;
    private List<Course> courses = new();
    private bool loading = true;
    private string? successMessage;
    private string? errorMessage;
    private string searchTerm = string.Empty;
    private string selectedDepartment = string.Empty;
    private string eligibilityFilter = "all";

    private int AssignedCredits =>
        student?.Enrollments.Sum(
            enrollment => enrollment.Course.Credits) ?? 0;

    private int TotalCreditLoad =>
        (student?.CurrentCredits ?? 0) + AssignedCredits;

    private int RemainingCredits =>
        student is null
            ? 0
            : Math.Max(
                0,
                student.MaxCreditsAllowed - TotalCreditLoad);

    private bool HasActiveCourseFilters =>
    !string.IsNullOrWhiteSpace(searchTerm) ||
    !string.IsNullOrWhiteSpace(selectedDepartment) ||
    eligibilityFilter != "all";

    private void ClearCourseFilters()
    {
        searchTerm = string.Empty;
        selectedDepartment = string.Empty;
        eligibilityFilter = "all";
    }

    private IEnumerable<string> Departments =>
    courses
        .Select(course => course.Department)
        .Distinct()
        .OrderBy(department => department);

    private IEnumerable<Course> FilteredCourses
    {
        get
        {
            if (student is null)
            {
                return Enumerable.Empty<Course>();
            }

            return courses.Where(course =>
            {
                var matchesSearch =
                    string.IsNullOrWhiteSpace(searchTerm) ||
                    course.CourseNumber.Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase) ||
                    course.CourseName.Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase);

                var matchesDepartment =
                    string.IsNullOrWhiteSpace(selectedDepartment) ||
                    course.Department == selectedDepartment;

                var eligibility =
                    EnrollmentService.CheckEligibility(student, course);

                var matchesEligibility = eligibilityFilter switch
                {
                    "eligible" => eligibility.IsEligible,
                    "ineligible" => !eligibility.IsEligible,
                    _ => true
                };

                return matchesSearch &&
                       matchesDepartment &&
                       matchesEligibility;
            });
        }
    }

    private string GetEligibilityButtonClass(string filter)
    {
        return eligibilityFilter == filter
            ? "btn btn-primary"
            : "btn btn-outline-primary";
    }

    protected override async Task OnInitializedAsync()
    {
        student = await StudentService
            .GetStudentByIdAsync(StudentId);

        courses = await CourseService.GetCoursesAsync();

        loading = false;
    }
    private async Task AssignCourseAsync(int courseId)
    {
        if (student is null)
        {
            return;
        }

        successMessage = null;
        errorMessage = null;

        var result = await EnrollmentService.AssignCourseAsync(
            student.Id,
            courseId);

        if (!result.IsEligible)
        {
            errorMessage = result.Reason;
            return;
        }

        successMessage = "Course assigned successfully.";

        await ReloadStudentAsync();
    }
    private async Task ReloadStudentAsync()
    {
        student = await StudentService
            .GetStudentByIdAsync(StudentId);
    }
    private async Task RemoveCourseAsync(int courseId)
    {
        if (student is null)
        {
            return;
        }

        successMessage = null;
        errorMessage = null;

        var removed = await EnrollmentService.RemoveCourseAsync(
            student.Id,
            courseId);

        if (!removed)
        {
            errorMessage = "The course assignment could not be found.";
            return;
        }

        successMessage = "Course removed successfully.";

        await ReloadStudentAsync();
    }
}