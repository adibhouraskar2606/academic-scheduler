@page "/students"
@rendermode InteractiveServer
@using AcademicScheduler.Models
@using AcademicScheduler.Services
@inject StudentService StudentService

<PageTitle>Students</PageTitle>

<h1>Students</h1>

<p class="text-muted">
    View student academic progress and course completion history.
</p>

<div class="mb-4">
    <input type="text" class="form-control" placeholder="Search by name, email, or house..." @bind="searchTerm"
           @bind:event="oninput" />
</div>

@if (students is null)
{
    <p>Loading students...</p>
}
else if (students.Count == 0)
{
    <div class="alert alert-info">
        No students were found.
    </div>
}
else
{
    var filteredStudents = FilteredStudents.ToList();

    if (filteredStudents.Count == 0)
    {
        <div class="alert alert-info">
            No students match your search.
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
        <strong>@filteredStudents.Count Student(s)</strong>
        </div>
        
        <div class="row g-4">
            @foreach (var student in filteredStudents)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">
                                        @student.FirstName @student.LastName
                                    </h5>

                                    <div class="text-muted">
                                        @student.Email
                                    </div>
                                </div>

                                <span class="badge text-bg-secondary">
                                    Year @student.YearLevel
                                </span>
                            </div>

                            <p class="mb-2">
                                <strong>House:</strong>
                                @student.HouseAffiliation
                            </p>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <strong>Current Credit Load</strong>
                                    <span>
                                        @student.CurrentCredits / @student.MaxCreditsAllowed
                                    </span>
                                </div>

                                <div class="progress"
                                     role="progressbar"
                                     aria-label="Current credit load"
                                     aria-valuenow="@student.CurrentCredits"
                                     aria-valuemin="0"
                                     aria-valuemax="@student.MaxCreditsAllowed">

                                    <div class="progress-bar"
                                         style="width: @GetCreditPercentage(student)%">
                                    </div>
                                </div>
                            </div>

                            <p class="mb-2">
                                <strong>Completed Courses:</strong>
                                @student.CompletedCourses.Count
                            </p>

                            <div class="d-flex flex-wrap gap-1 mb-4">
                                @foreach (var completedCourse in student.CompletedCourses)
                                {
                                    <span class="badge bg-light text-dark border">
                                        @completedCourse.Course.CourseNumber
                                    </span>
                                }
                            </div>

                            <a class="btn btn-outline-primary"
                               href="@($"/students/{student.Id}")">
                                View Schedule
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<Student>? students;
    private string searchTerm = string.Empty;

    private IEnumerable<Student> FilteredStudents =>
        students?.Where(student =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            $"{student.FirstName} {student.LastName}"
                .Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            student.Email
                .Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            student.HouseAffiliation
                .Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Student>();

    protected override async Task OnInitializedAsync()
    {
        students = await StudentService.GetStudentsAsync();
    }
    private static int GetCreditPercentage(Student student)
    {
        if (student.MaxCreditsAllowed <= 0)
        {
            return 0;
        }

        return (int)Math.Round(
            (double)student.CurrentCredits /
            student.MaxCreditsAllowed * 100);
    }
}